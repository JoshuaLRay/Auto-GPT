# Copy to .env and adjust. All settings are read from the environment.

# HTTP listen address.
STREAMHUB_ADDR=:8080

# Where the SQLite DB and transcode cache live.
STREAMHUB_DATA_DIR=./data

# One or more media roots to scan, separated by the OS path-list separator
# (":" on Linux/macOS, ";" on Windows).
STREAMHUB_MEDIA_DIRS=./media

# Bootstrap admin account. The password is hashed on first run. Leaving the
# password blank disables the admin account until it's set.
STREAMHUB_ADMIN_USER=admin
STREAMHUB_ADMIN_PASSWORD=

# Long random string used to sign access tokens. If unset, an ephemeral secret
# is generated and ALL tokens are invalidated on restart — set this in production.
STREAMHUB_JWT_SECRET=

# Optional: a TMDB API key enables rich movie metadata (posters, overviews).
# Without it, titles/years are derived from filenames.
STREAMHUB_TMDB_API_KEY=

# Paths to the FFmpeg tools (defaults assume they're on PATH).
STREAMHUB_FFMPEG=ffmpeg
STREAMHUB_FFPROBE=ffprobe

# Directory of the built web app to serve at "/". When set, the server hosts
# the web UI on the same port as the API (one URL). Empty = API only. The
# Docker image sets this to /web automatically.
# STREAMHUB_WEB_DIR=../clients/web/dist

# Max accepted upload size (MB) for the admin upload endpoint.
STREAMHUB_MAX_UPLOAD_MB=4096

# When "1", synthesize a sample clip on startup if the library is empty. Handy
# on fresh/ephemeral cloud deployments so there's something to stream.
STREAMHUB_GENERATE_SAMPLE=0

# PaaS platforms (Render, Railway, …) inject PORT; the server listens on it when
# STREAMHUB_ADDR is unset. You normally don't set this yourself.
# PORT=10000
